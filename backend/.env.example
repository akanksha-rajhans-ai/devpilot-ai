APP_NAME="DevPilot AI"
APP_VERSION="0.1.0"
ENVIRONMENT="local"

API_V1_PREFIX="/api/v1"

LOG_LEVEL="INFO"

LLM_PROVIDER="mock"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

EMBEDDING_PROVIDER="mock"
EMBEDDING_DIMENSION=384
EMBEDDING_MODEL="mock-lexical-v1"

# Free local semantic model profile:
# EMBEDDING_PROVIDER="sentence_transformers"
# EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
# EMBEDDING_DIMENSION=384

DOCUMENT_REPOSITORY="memory"
RAG_DEFAULT_TOP_K=4
RAG_MAX_TOP_K=10
RAG_MIN_SIMILARITY=0.0

JWT_SECRET_KEY="dev-only-change-me"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

DATABASE_URL="sqlite:///./devpilot.db"
REDIS_URL="redis://localhost:6379/0"

OTEL_ENABLED=false
OTEL_SERVICE_NAME="devpilot-ai"
OTEL_EXPORTER_OTLP_ENDPOINT=""
CORS_ORIGINS="http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173"

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

DATABASE_URL="sqlite:///./devpilot.db"

# PostgreSQL example:
# DATABASE_URL="postgresql+psycopg://devpilot:devpilot@localhost:5432/devpilot"
